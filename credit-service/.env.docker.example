# Copy to .env.docker locally. Do not commit the populated file.
ENVIRONMENT=development
# Use only Credit's database credentials. No migration runs on service startup.
DATABASE_URL=postgresql://<credit-user>:<password>@host.docker.internal:16522/postgres

# Team-agreed starting credit for every wallet (registration or first use by an existing user).
INITIAL_CREDIT_ALLOCATION=20
# Dedicated Order-to-Credit credential. Must equal Order's CREDIT_SERVICE_SECRET.
ORDER_SERVICE_SECRET=
