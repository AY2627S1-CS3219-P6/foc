ENVIRONMENT=development
# From `npx supabase status` in credit-service/. Never commit credentials.
# Host process: postgresql://<user>:<password>@127.0.0.1:16522/postgres
# An unset URL keeps liveness available but readiness returns 503.
DATABASE_URL=

# Team-agreed starting credit for every wallet (registration or first use by an existing user).
INITIAL_CREDIT_ALLOCATION=20
# Dedicated Order-to-Credit credential. Must equal Order's CREDIT_SERVICE_SECRET.
# Generate locally, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
ORDER_SERVICE_SECRET=
# Fixed User origin for current-session checks (GET /v1/users/me).
USER_SERVICE_BASE_URL=http://127.0.0.1:8000
DEPENDENCY_TIMEOUT_SECONDS=2
