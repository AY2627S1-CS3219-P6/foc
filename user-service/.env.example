# Copy to .env, or run scripts/generate_dev_secrets.py after starting local Supabase.
# Do not commit .env or files under secrets/.

ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=
# Docker containers cannot reach the Supabase CLI database through 127.0.0.1.
# The development-secret script derives this local-only value from DATABASE_URL.
DATABASE_URL_DOCKER=

# RSA key paths, relative to user-service/. Generated by the development-secret script.
JWT_PRIVATE_KEY_PATH=secrets/development/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=secrets/development/jwt_public_key.pem
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-services
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# Generated by scripts/generate_dev_secrets.py.
OTP_HMAC_SECRET=
INTERNAL_SERVICE_SECRET=

# Local supporting services. The secret generator supplies non-guest RabbitMQ
# credentials; Compose uses the same values for the service container.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@foc.local
RABBITMQ_USER=foc_user_service
RABBITMQ_PASSWORD=replace-with-local-only-password
RABBITMQ_URL=amqp://foc_user_service:replace-with-local-only-password@127.0.0.1:5672/
