# Copy to .env, or run scripts/generate_dev_secrets.py after starting local Supabase.
# Do not commit .env or files under secrets/.

ENVIRONMENT=development
DATABASE_URL=

# RSA key paths, relative to user-service/. Generated by the development-secret script.
JWT_PRIVATE_KEY_PATH=secrets/development/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=secrets/development/jwt_public_key.pem
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-services
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=1209600

# Generated by scripts/generate_dev_secrets.py.
OTP_HMAC_SECRET=
INTERNAL_SERVICE_SECRET=

# Local supporting services; Compose will provide these endpoints.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@foc.local
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
