# Local Supabase database. Use a hosted PostgreSQL URL here when needed.
SUPPLIER_DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:55322/postgres'

# User Service base URL and the secret configured by its operator.
USER_SERVICE_BASE_URL='http://127.0.0.1:8000'
SUPPLIER_SERVICE_SHARED_SECRET='replace-with-the-user-service-shared-secret'

# Must match User Service's JWT issuer and audience settings.
USER_SERVICE_JWT_ISSUER=foc-user-service
USER_SERVICE_JWT_AUDIENCE=foc-services

# Root Compose connects to the local database through host.docker.internal
# and User Service through http://user-service:8000. To override the Docker
# database address, export SUPPLIER_DATABASE_URL_DOCKER in the shell running
# root Compose; service env_file values do not supply Compose interpolation.
