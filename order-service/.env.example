ENVIRONMENT=development
# Set locally from this service's Supabase connection information. Never commit credentials.
# Host process: postgresql://<user>:<password>@127.0.0.1:16422/postgres
# Docker Desktop: use host.docker.internal instead of 127.0.0.1.
# An unset URL keeps liveness available but readiness returns 503.
DATABASE_URL=

# Fixed service origins; use container DNS/host.docker.internal for container runs.
USER_SERVICE_BASE_URL=http://127.0.0.1:8000
SUPPLIER_SERVICE_BASE_URL=http://127.0.0.1:8001
# Proposed Credit contract: leave unset until a compatible Credit service is available.
CREDIT_SERVICE_BASE_URL=
# Dedicated Order-to-Credit credential, never Supplier's shared secret or a user token.
CREDIT_SERVICE_SECRET=
DEPENDENCY_TIMEOUT_SECONDS=2
RECOVERY_INTERVAL_SECONDS=5
RECOVERY_BATCH_SIZE=50
