# AI Assistance Disclosure:
# Tool: ChatGPT (Codex, model: gpt-6-astra), date: 2026-10-09, 2026-10-11
# Scope: Added Docker environment placeholders for Order API and workers.
# Author review: I validated correctness and added boundary checks where needed.

# Copy to .env.docker locally. Do not commit the populated file.
ENVIRONMENT=development
# Use only Order's database credentials. No migration runs on service startup.
DATABASE_URL=postgresql://<order-user>:<password>@host.docker.internal:16422/postgres
USER_SERVICE_BASE_URL=http://host.docker.internal:8000
SUPPLIER_SERVICE_BASE_URL=http://host.docker.internal:8001
# Root Compose overrides the two origins above with service DNS names.
# Root Compose also sets CREDIT_SERVICE_BASE_URL. The secret must equal Credit's
# ORDER_SERVICE_SECRET (credit-service/.env.docker). Leave both blank to run without Credit.
CREDIT_SERVICE_BASE_URL=
CREDIT_SERVICE_SECRET=
# Must equal Admin Service's ORDER_SERVICE_SECRET (admin-service/.env.docker). Only Admin
# Service may hold errands in, or release them from, DISPUTED.
ADMIN_SERVICE_SECRET=
DEPENDENCY_TIMEOUT_SECONDS=2
RECOVERY_INTERVAL_SECONDS=5
RECOVERY_BATCH_SIZE=50
EXPIRY_INTERVAL_SECONDS=5
EXPIRY_BATCH_SIZE=50
# Root Compose supplies its broker URL only to the outbox publisher.
RABBITMQ_URL=
OUTBOX_EXCHANGE_NAME=foc.events
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_LEASE_SECONDS=30
