# Supabase defaults for Chat's isolated local database only.
# Use a dedicated restricted database login for deployment.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:17422/postgres
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:postgres@host.docker.internal:17422/postgres
# Copy the shared broker's credentials from User Service's ignored configuration.
RABBITMQ_URL=amqp://REPLACE_WITH_RABBITMQ_USER:REPLACE_WITH_RABBITMQ_PASSWORD@127.0.0.1:5672/
RABBITMQ_URL_DOCKER=amqp://REPLACE_WITH_RABBITMQ_USER:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/
USER_SERVICE_BASE_URL=http://127.0.0.1:8000
CHAT_SERVICE_SHARED_SECRET=REPLACE_WITH_DEDICATED_CHAT_SECRET
JWT_ISSUER=foc-user-service
JWT_AUDIENCE=foc-services
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]
