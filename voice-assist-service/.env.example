ENVIRONMENT=development

# Fixed User origin for current-session checks (GET /v1/users/me).
USER_SERVICE_BASE_URL=http://127.0.0.1:8000
# Fixed Supplier origin for active-supplier matching (GET /api/v1/suppliers).
SUPPLIER_SERVICE_BASE_URL=http://127.0.0.1:8001
DEPENDENCY_TIMEOUT_SECONDS=2

# "openai" sends audio to OpenAI; "fake" returns a canned draft with no provider call.
VOICE_ASSIST_PROVIDER=openai
# Never commit a real key. An unset key keeps the service up but reports voice drafting
# as unavailable; the ordinary errand form is unaffected.
OPENAI_API_KEY=
VOICE_ASSIST_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VOICE_ASSIST_DRAFT_MODEL=gpt-4.1-mini
VOICE_ASSIST_TRANSCRIBE_TIMEOUT_SECONDS=12
VOICE_ASSIST_DRAFT_TIMEOUT_SECONDS=12
VOICE_ASSIST_TOTAL_TIMEOUT_SECONDS=25
VOICE_ASSIST_MAX_AUDIO_BYTES=2000000
VOICE_ASSIST_USER_LIMIT=10
VOICE_ASSIST_USER_WINDOW_SECONDS=600
VOICE_ASSIST_DAILY_LIMIT=500
# Optional override of the disclosure shown before recording (N3NFR3.5).
# VOICE_ASSIST_RETENTION_NOTICE=
