# Copy to .env.docker locally. Do not commit the populated file.
ENVIRONMENT=development
# Use only Admin's database credentials. No migration runs on service startup.
DATABASE_URL=postgresql://<admin-user>:<password>@host.docker.internal:17522/postgres

# Fixed User origin for current-session checks. Root Compose overrides it with service DNS.
USER_SERVICE_BASE_URL=http://host.docker.internal:8000
DEPENDENCY_TIMEOUT_SECONDS=2
