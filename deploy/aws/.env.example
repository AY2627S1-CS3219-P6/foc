# Configuration contract for the isolated EC2 sandbox, not the root foc-dev stack.
# On EC2, scripts/generate_env.py generates .env and fresh cloud-only secrets.
# Never copy a populated laptop environment or print `docker compose config`.
FOC_USER_UID=1000
FOC_USER_GID=1000
# The foundation listens on loopback for private Session Manager checks.
# Public HTTPS/CloudFront and its restricted origin are a separate rollout step.
FOC_PUBLIC_ORIGIN=http://localhost:3000
USER_DATABASE_URL=postgresql+asyncpg://foc_user_runtime:REPLACE@host.docker.internal:15422/postgres
SUPPLIER_DATABASE_URL=postgresql://foc_supplier_runtime:REPLACE@host.docker.internal:55322/postgres
ORDER_DATABASE_URL=postgresql://foc_order_runtime:REPLACE@host.docker.internal:16422/postgres
CREDIT_DATABASE_URL=postgresql://foc_credit_runtime:REPLACE@host.docker.internal:16522/postgres
CHAT_DATABASE_URL=postgresql+asyncpg://foc_chat_runtime:REPLACE@host.docker.internal:17422/postgres
ADMIN_DATABASE_URL=postgresql://foc_admin_runtime:REPLACE@host.docker.internal:17522/postgres
OTP_HMAC_SECRET=REPLACE
SUPPLIER_SERVICE_SHARED_SECRET=REPLACE
CHAT_SERVICE_SHARED_SECRET=REPLACE
ORDER_CREDIT_SHARED_SECRET=REPLACE
RABBITMQ_USER=foc_cloud
RABBITMQ_PASSWORD=REPLACE
# Optional real voice provider credential; blank means unavailable, never fake success.
OPENAI_API_KEY=

