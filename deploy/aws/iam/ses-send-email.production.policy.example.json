{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendFoCNusVerificationEmail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:ap-southeast-1:REPLACE_ACCOUNT_ID:identity/*",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "REPLACE_VERIFIED_SENDER"
        },
        "ForAllValues:StringLike": {
          "ses:Recipients": ["*@u.nus.edu"]
        },
        "Null": {
          "ses:Recipients": "false"
        }
      }
    }
  ]
}
